  "item": [
    {
      "name": "Canciones",
      "item": [
        {
          "name": "GET - Obtener todas las canciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/canciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "canciones"
              ]
            },
            "description": "Obtiene la lista completa de canciones. Respuesta esperada: 200 OK."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es un arreglo\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Crear una canción",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"The Black - Imminence\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/canciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "canciones"
              ]
            },
            "description": "Crea una canción. El servidor asigna automáticamente el ID y escuchada=false."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const respuesta = pm.response.json();",
                  "pm.collectionVariables.set(\"createdId\", respuesta.id);",
                  "",
                  "pm.test(\"La canción tiene ID\", function () {",
                  "    pm.expect(respuesta).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"escuchada inicia en false\", function () {",
                  "    pm.expect(respuesta.escuchada).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Crear varias canciones",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"titulo\": \"Tsunami Sea - Spiritbox\"\n  },\n  {\n    \"titulo\": \"Circle With Me - Spiritbox\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/canciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "canciones"
              ]
            },
            "description": "Crea varias canciones mediante un arreglo JSON."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"La respuesta contiene varias canciones\", function () {",
                  "    const respuesta = pm.response.json();",
                  "    pm.expect(respuesta).to.be.an('array');",
                  "    pm.expect(respuesta.length).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
