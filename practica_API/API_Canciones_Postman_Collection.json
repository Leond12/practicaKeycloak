            },
            "url": {
              "raw": "{{baseUrl}}/canciones/{{cancionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "canciones",
                "{{cancionId}}"
              ]
            },
            "description": "Modifica el campo escuchada de la canción indicada por cancionId."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La canción está escuchada\", function () {",
                  "    pm.expect(pm.response.json().escuchada).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
